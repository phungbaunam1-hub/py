<Window x:Class="FlowDesk.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="clr-namespace:FlowDesk.Desktop.Controls"
        Title="FlowDesk · Order Flow Workspace"
        Width="1560" Height="980" MinWidth="1200" MinHeight="800"
        WindowStartupLocation="CenterScreen" Background="#090E17"
        Foreground="#E7EDF5" FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111A28" />
        <SolidColorBrush x:Key="Edge" Color="#243147" />
        <SolidColorBrush x:Key="Muted" Color="#94A6BC" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A111D" />
            <Setter Property="Foreground" Value="#E7EDF5" />
            <Setter Property="BorderBrush" Value="#2C3B52" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#226F76" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#122033" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A2A3E" />
            <Setter Property="Foreground" Value="#E7EDF5" />
            <Setter Property="BorderBrush" Value="#33465F" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,12,0,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0D1522" />
            <Setter Property="Foreground" Value="#DFE7F1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="#0D1522" />
            <Setter Property="AlternatingRowBackground" Value="#111C2B" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowHeight" Value="29" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#172337" />
            <Setter Property="Foreground" Value="#9BAFC7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#263F59" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#0B111C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Margin="8,5,8,0" />
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8FA5BE" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#1A2A3E" /><Setter Property="Foreground" Value="#DBE7F4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18,14,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FLOW" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="DESK" Foreground="#36D4BC" FontSize="27" FontWeight="Light" />
                    <Border Background="#153B39" CornerRadius="4" Margin="15,7,0,5" Padding="10,3">
                        <TextBlock Text="{Binding FeedLabel}" Foreground="#70E8D7" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Futures market data · Candles / Tape / Depth" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" MaxWidth="470" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                </StackPanel>
                <TextBlock Text="{Binding FeedTimeText}" Foreground="{StaticResource Muted}" FontFamily="Consolas" Margin="0,8,0,0" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="286" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="15">
                        <TextBlock Text="CONNECTION" Style="{StaticResource Heading}" />
                        <TextBlock Text="Source" Style="{StaticResource Label}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding IsDisconnected}" />
                        <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0" />
                        <TextBlock Text="Rithmic username" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDisconnected}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="75" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Contract symbol" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDisconnected}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Exchange" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Exchange, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDisconnected}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Tick size" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding TickSize, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDisconnected}" />
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Connect" Command="{Binding ConnectCommand}" Background="#167F70" BorderBrush="#28A994" FontWeight="SemiBold" />
                            <Button Grid.Column="2" Content="Disconnect" Command="{Binding DisconnectCommand}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource Edge}" Margin="0,20,0,18" />
                        <TextBlock Text="ORDER FLOW FILTERS" Style="{StaticResource Heading}" />
                        <TextBlock Text="Big trade · minimum contracts" Style="{StaticResource Label}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding MinimumTradeSize, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Book wall · displayed contracts" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding MinimumWallSize, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Sweep · minimum contracts" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding MinimumSweepVolume, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sweep levels" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding MinimumSweepLevels, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Window · ms" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding SweepWindowMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Candle interval · seconds" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding CandleSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Apply filters" Command="{Binding ApplySettingsCommand}" Margin="0,14,0,0" />
                        <TextBlock Text="Changing the candle interval resets the local chart. Live candles begin with newly received trades." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" />
                        <Border Background="#0B1420" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="ACCOUNT / SESSION" FontSize="10" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding AccountText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="78" /><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="230" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="7" Padding="14,8">
                        <StackPanel><TextBlock Text="LAST PRICE" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="{Binding LastPriceText}" FontSize="23" FontFamily="Consolas" Margin="0,3,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="7" Padding="14,8">
                        <StackPanel><TextBlock Text="SESSION DELTA" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="{Binding DeltaText}" Foreground="#52DCC3" FontSize="23" FontFamily="Consolas" Margin="0,3,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="7" Padding="14,8">
                        <StackPanel><TextBlock Text="INSTRUMENT" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="{Binding Symbol}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1" Background="#0B111C" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <TabControl>
                        <TabItem Header="CANDLES + BIG TRADES">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="27" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="Scroll to zoom · UTC · bubbles show filtered prints" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0" />
                                <charts:CandlestickChart Grid.Row="1" Candles="{Binding Candles}" BigTrades="{Binding ChartTrades}"
                                                         ToolTip="Candles are built from received trades. Bubble radius grows with the square root of relative print size; green = buyer-initiated, red = seller-initiated. Unknown aggressor trades do not contribute to delta." />
                            </Grid>
                        </TabItem>
                        <TabItem Header="DEPTH HEATMAP">
                            <charts:DepthHeatmap History="{Binding DepthHistory}"
                                                 ToolTip="Sampled displayed book depth from this session. Color intensity is relative size; this is not historical or order-by-order exchange data." />
                        </TabItem>
                    </TabControl>
                </Border>
                <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="FILTERED TAPE · BIG TRADES" Margin="14,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding BigTrades}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TIME · UTC" Binding="{Binding Time}" Width="105" />
                                <DataGridTextColumn Header="AGGRESSOR" Binding="{Binding Side}" Width="100" />
                                <DataGridTextColumn Header="PRICE" Binding="{Binding Price}" Width="*" />
                                <DataGridTextColumn Header="CONTRACTS" Binding="{Binding Size}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="230" /></Grid.RowDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
                        <TextBlock Text="DEPTH OF MARKET" Margin="14,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DepthRows}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWall}" Value="True"><Setter Property="Background" Value="#49391E" /><Setter Property="Foreground" Value="#FFD48A" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SIDE" Binding="{Binding Side}" Width="62" />
                                <DataGridTextColumn Header="PRICE" Binding="{Binding Price}" Width="*" />
                                <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="66" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Amber = displayed size above wall threshold" Foreground="#CBA968" FontSize="10" VerticalAlignment="Center" Margin="10,0" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <TabControl>
                        <TabItem Header="FLOW SIGNALS">
                            <DataGrid ItemsSource="{Binding Signals}" FontSize="10">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Description}" /></Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="80" />
                                    <DataGridTextColumn Header="EVENT" Binding="{Binding Kind}" Width="*" />
                                    <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="SESSION LOG">
                            <ListBox ItemsSource="{Binding Logs}" Background="#0D1522" Foreground="#A5B8CE" BorderThickness="0" Padding="6" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" /></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="Order flow heuristics · not proprietary MZpack · no order routing" Foreground="#7D90A8" FontSize="10" VerticalAlignment="Center" />
            <TextBlock Text="R|Trader Pro plugin integration requires the official SDK" Foreground="#7D90A8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
